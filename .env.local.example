# Copy to web/.env.local when the Vite app should use the shared hosted project.
# Get these browser-safe values from Supabase Project Settings > API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# For a fully local stack instead, use web/.env.example and paste the local
# anon key printed by `npx supabase start`.
# Never put a service-role key in Vite env files, docs, screenshots, or client code.
